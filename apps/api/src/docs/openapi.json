{
  "openapi": "3.0.3",
  "info": {
    "title": "Korziva E-Commerce Platform API",
    "description": "Production-grade REST API powering the Korziva modern e-commerce storefront and executive admin dashboard. Features transactional order management, inventory decrements, JWT access/refresh token rotation, and guest-to-customer cart persistence.",
    "version": "1.0.0",
    "contact": {
      "name": "Korziva Engineering",
      "email": "support@korziva.dev"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token passed in Authorization header: `Bearer <token>`"
      },
      "CartSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "korziva_cart_session",
        "description": "Guest session UUID maintained via cookie or x-cart-session header"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": { "type": "string", "example": "Invalid input provided" },
              "details": { "type": "object" }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "role": { "type": "string", "enum": ["CUSTOMER", "ADMIN"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "imageUrl": { "type": "string", "nullable": true },
          "_count": {
            "type": "object",
            "properties": {
              "products": { "type": "integer" }
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "priceInCents": { "type": "integer", "description": "Minor currency unit ($1.00 = 100)" },
          "compareAtPriceInCents": { "type": "integer", "nullable": true },
          "stock": { "type": "integer" },
          "sku": { "type": "string" },
          "isFeatured": { "type": "boolean" },
          "category": { "$ref": "#/components/schemas/Category" },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "url": { "type": "string" },
                "altText": { "type": "string", "nullable": true },
                "isPrimary": { "type": "boolean" }
              }
            }
          }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "quantity": { "type": "integer" },
          "unitPriceInCents": { "type": "integer" },
          "totalPriceInCents": { "type": "integer" },
          "product": { "$ref": "#/components/schemas/Product" }
        }
      },
      "Cart": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "itemCount": { "type": "integer" },
          "subtotalInCents": { "type": "integer" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CartItem" }
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "orderNumber": { "type": "string", "example": "KZ-ORD-20261026-A1B2C3" },
          "customerEmail": { "type": "string" },
          "customerName": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"] },
          "paymentStatus": { "type": "string", "enum": ["PENDING", "COMPLETED", "FAILED", "REFUNDED"] },
          "subtotalInCents": { "type": "integer" },
          "shippingInCents": { "type": "integer" },
          "taxInCents": { "type": "integer" },
          "totalInCents": { "type": "integer" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "productName": { "type": "string" },
                "productSku": { "type": "string" },
                "unitPriceInCents": { "type": "integer" },
                "quantity": { "type": "integer" },
                "totalPriceInCents": { "type": "integer" },
                "productImageUrl": { "type": "string", "nullable": true }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "System Health & Database Connectivity",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Operating status and record counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Korziva API and Database are operating normally" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "example": "ok" },
                        "service": { "type": "string", "example": "Korziva API" },
                        "uptime": { "type": "integer" },
                        "database": {
                          "type": "object",
                          "properties": {
                            "status": { "type": "string", "example": "connected" },
                            "provider": { "type": "string", "example": "PostgreSQL" },
                            "counts": { "type": "object" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a new customer account",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "dineth@example.com" },
                  "password": { "type": "string", "minLength": 8, "example": "Password123!" },
                  "firstName": { "type": "string", "example": "Dineth" },
                  "lastName": { "type": "string", "example": "Gimhan" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created successfully" },
          "400": { "description": "Validation error" },
          "409": { "description": "Email already registered" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate with email and password",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "customer@korziva.dev" },
                  "password": { "type": "string", "example": "Customer123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful, returns access token & sets refresh cookie" },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "tags": ["Authentication"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile with saved addresses" },
          "401": { "description": "Unauthorized / Missing or invalid token" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token using rotate cookie",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "New access token generated" },
          "401": { "description": "Invalid or revoked refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout and revoke refresh token",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Session revoked and cookies cleared" }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List catalog products with filtering, search, and pagination",
        "tags": ["Products"],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Keyword search across name and description" },
          { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Category slug filter" },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["featured", "newest", "price_asc", "price_desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 12 } }
        ],
        "responses": {
          "200": { "description": "Paginated list of products" }
        }
      }
    },
    "/products/{slug}": {
      "get": {
        "summary": "Get product details by slug",
        "tags": ["Products"],
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product details" },
          "404": { "description": "Product not found" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "List all active categories with product counts",
        "tags": ["Categories"],
        "responses": {
          "200": { "description": "Array of categories" }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "Get active cart contents and totals",
        "tags": ["Cart"],
        "responses": {
          "200": { "description": "Cart with item details, count, and subtotal" }
        }
      },
      "delete": {
        "summary": "Clear all items from active cart",
        "tags": ["Cart"],
        "responses": {
          "200": { "description": "Cart cleared" }
        }
      }
    },
    "/cart/items": {
      "post": {
        "summary": "Add product to active cart",
        "tags": ["Cart"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId", "quantity"],
                "properties": {
                  "productId": { "type": "string" },
                  "quantity": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Item added to cart" },
          "400": { "description": "Insufficient inventory or invalid quantity" },
          "404": { "description": "Product not found" }
        }
      }
    },
    "/orders/checkout": {
      "post": {
        "summary": "Execute transactional checkout with atomic stock decrements",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customerName", "customerEmail", "shippingAddress", "paymentMethod"],
                "properties": {
                  "customerName": { "type": "string" },
                  "customerEmail": { "type": "string", "format": "email" },
                  "customerPhone": { "type": "string" },
                  "shippingAddress": {
                    "type": "object",
                    "required": ["fullName", "street", "city", "state", "postalCode", "country"],
                    "properties": {
                      "fullName": { "type": "string" },
                      "street": { "type": "string" },
                      "city": { "type": "string" },
                      "state": { "type": "string" },
                      "postalCode": { "type": "string" },
                      "country": { "type": "string" },
                      "phone": { "type": "string" }
                    }
                  },
                  "paymentMethod": { "type": "string", "enum": ["CARD", "SIMULATED", "CASH_ON_DELIVERY"] },
                  "saveAddress": { "type": "boolean" },
                  "idempotencyKey": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order successfully created" },
          "400": { "description": "Cart is empty or insufficient stock for item" },
          "422": { "description": "Payment simulated rejection" }
        }
      }
    },
    "/orders/{orderNumber}": {
      "get": {
        "summary": "Get order details and item snapshots by order number",
        "tags": ["Orders"],
        "parameters": [
          { "name": "orderNumber", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Order details" },
          "404": { "description": "Order not found" }
        }
      }
    },
    "/admin/metrics": {
      "get": {
        "summary": "Executive KPI metrics, 7-day sales curve, low stock inventory, recent orders",
        "tags": ["Admin"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Executive metrics" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Administrator privilege required" }
        }
      }
    },
    "/admin/products": {
      "get": {
        "summary": "List all products for inventory control",
        "tags": ["Admin"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Products with inventory details" } }
      },
      "post": {
        "summary": "Create new product in catalog",
        "tags": ["Admin"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "201": { "description": "Product created" } }
      }
    },
    "/admin/products/{id}/stock": {
      "patch": {
        "summary": "Inline inventory stock adjustment",
        "tags": ["Admin"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["stock"],
                "properties": {
                  "stock": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Stock updated" } }
      }
    },
    "/admin/orders/{id}/status": {
      "patch": {
        "summary": "Update order status",
        "tags": ["Admin"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"] }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Order status updated" } }
      }
    }
  }
}
