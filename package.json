{
  "name": "korziva",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@korziva/api",
    "dev:web": "npm run dev --workspace=@korziva/web",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace=@korziva/api",
    "build:web": "npm run build --workspace=@korziva/web",
    "db:generate": "npm run prisma:generate --workspace=@korziva/api",
    "db:migrate": "npm run prisma:migrate --workspace=@korziva/api",
    "db:deploy": "npm run prisma:deploy --workspace=@korziva/api",
    "db:seed": "npm run prisma:seed --workspace=@korziva/api",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace=@korziva/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
